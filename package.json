{
  "name": "foi-navigator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A public MCP connector that guides Australian Government FOI practitioners through incoming requests under the FOI Act 1982 (Cth).",
  "scripts": {
    "content:fetch": "node scripts/fetch-sources.ts",
    "content:build": "node scripts/build-content.ts",
    "widget:build": "node scripts/build-widget.ts",
    "build": "pnpm widget:build",
    "db:load:local": "wrangler d1 execute foi-navigator --local --file data/d1/content.sql",
    "db:load:remote": "wrangler d1 execute foi-navigator --remote --file data/d1/content.sql",
    "index:remote": "node scripts/index-vectors.ts",
    "dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "esbuild": "^0.28.2",
    "node-html-parser": "^9.0.4",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.1"
  }
}
